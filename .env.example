APP_NAME="Summit Legal Consultancy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=summit
DB_USERNAME=summit
DB_PASSWORD=
# The test suite uses its own database (phpunit.xml: summit_test) with the same user.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Summit Legal Consultancy (config/summit.php) ---
SUMMIT_CANONICAL_HOST=https://www.summitlegaluae.com
# Set true on staging. Keep false for Lighthouse runs and production.
SUMMIT_NOINDEX=false
SUMMIT_ENQUIRY_INBOX=info@summitlegaluae.com
# Attachments stay off until uploads are validated, scanned and access-restricted.
SUMMIT_ATTACHMENTS_ENABLED=false
# Navigator step 1 (audience) uses a proposed mapping; hidden until the client approves it.
SUMMIT_NAVIGATOR_AUDIENCE_STEP=false
# proposed = "Where do you stand?" (needs approval) | approved = existing approved heading
SUMMIT_NAVIGATOR_HEADING=proposed
SUMMIT_OPEN_NOW_INDICATOR=true
SUMMIT_LANGUAGE_SUGGESTION=true
# Service worker + offline page (defaults to on only in production).
SUMMIT_PWA=false
# Cloudflare Turnstile public TEST keys (always pass). Replace with real keys in production.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Design 1 ("The File", tag design-1) or Design 2 (premium v2): see docs/upgrade-plan.md
SUMMIT_DEFAULT_DESIGN=1
# Floating "Design 1 | Design 2" switch (Alt+1 / Alt+2): internal demo tool, keep false in production
SUMMIT_DESIGN_SWITCHER=false
# Design 2 (config/design.php d2): the proposed live office-hours status in the contact block.
# Unset, it follows SUMMIT_OPEN_NOW_INDICATOR (Design 1's switch, and Design 2's before 2.1). The CMS setting
# hours.live_status must be on as well (Phase 3): either one turns it off.
SUMMIT_LIVE_STATUS=true
# Digits on Design 2 Arabic pages: the CMS setting languages.arabic_digits (western, 0-9, by default; a question for
# the client). Set western or eastern (٠-٩) here only to override the setting in one environment.
# SUMMIT_ARABIC_DIGITS=
# Design 2: show copy pending client approval (the tool blocks, the calculators page, two form fields). The CMS
# setting content.show_pending decides (null = on everywhere except production, brief 2.1 §8.7); set true or false
# here only to override it in one environment (false previews the production site).
# SUMMIT_SHOW_PENDING=
# Design 2 home: force the "Our Team" block on (1) or off (0) in one environment, over its CMS switch.
# SUMMIT_HOME_TEAM=

# Backups (config/backup.php; System, Backups): the folder that holds mysqldump (empty: /usr/bin, /usr/local/bin,
# /opt/homebrew/bin, /usr/local/mysql/bin, /Applications/XAMPP/bin, then the PATH); a zip password (AES-256) is recommended.
BACKUP_MYSQLDUMP_PATH=
BACKUP_ARCHIVE_PASSWORD=
