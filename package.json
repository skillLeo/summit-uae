{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && vite build --config vite.d2.config.js && vite build --config vite.admin.config.js",
        "build:d1": "vite build",
        "build:d2": "vite build --config vite.d2.config.js",
        "build:admin": "vite build --config vite.admin.config.js",
        "dev": "vite",
        "dev:d2": "vite --config vite.d2.config.js",
        "dev:admin": "vite --config vite.admin.config.js",
        "dev:all": "concurrently -k -n d1,d2 \"vite\" \"vite --config vite.d2.config.js\"",
        "qa": "playwright test",
        "qa:a11y": "playwright test tests/e2e/a11y.spec.mjs",
        "qa:lighthouse": "node scripts/qa/lighthouse.mjs",
        "lint:css": "stylelint \"resources/scss/**/*.scss\" && stylelint \"resources/css/d2/**/*.css\"",
        "lint:css:d2": "stylelint \"resources/css/d2/**/*.css\"",
        "test:js": "vitest run",
        "qa:d2": "playwright test --config playwright.d2.config.mjs",
        "qa:d2:visual": "playwright test --config playwright.d2.config.mjs --project=\"visual-*\"",
        "qa:d2:hero": "playwright test --config playwright.d2.config.mjs --project=hero",
        "qa:d2:variants": "QA_D2_VARIANTS=reduced,nojs playwright test --config playwright.d2.config.mjs --project=\"variants-*\"",
        "qa:d2:report": "node scripts/qa/d2-report.mjs",
        "qa:d2:d1-visual": "node scripts/qa/d1-visual.mjs",
        "qa:d2:lighthouse": "node scripts/qa/lighthouse-d2.mjs",
        "qa:d2:selftest": "node --test \"qa/lib/*.test.mjs\" && QA_SKIP_PREFLIGHT=1 playwright test --config playwright.d2.config.mjs --project=harness",
        "qa:screens": "node scripts/qa/screens.mjs",
        "qa:text-snapshot": "node scripts/qa/text-snapshot.mjs",
        "qa:text-snapshot:check": "node scripts/qa/text-snapshot.mjs --check",
        "qa:lint": "node scripts/qa/lint-design.mjs",
        "qa:docx": "node scripts/qa/docx-conformance.mjs",
        "qa:docx:selftest": "node --test scripts/qa/docx-conformance.test.mjs",
        "qa:budgets": "node scripts/qa/budgets.mjs",
        "compliance": "node scripts/compliance-check.mjs"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@fontsource-variable/onest": "5.3.1",
        "@fontsource/ibm-plex-sans-arabic": "5.3.0",
        "@playwright/test": "^1.65.0",
        "@tailwindcss/vite": "4.3.3",
        "bootstrap": "^5.3.8",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "lighthouse": "^13.6.0",
        "sass-embedded": "^1.108.1",
        "sharp": "^0.35.5",
        "stylelint": "^17.16.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "svgo": "^4.1.0",
        "tailwindcss": "4.3.3",
        "vite": "^8.0.0",
        "vitest": "^4.1.12"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@alpinejs/csp": "^3.17.5",
        "@alpinejs/focus": "^3.17.5",
        "alpinejs": "^3.17.5",
        "gsap": "^3.15.1",
        "minisearch": "^7.2.0",
        "motion": "^14.6.0"
    }
}
